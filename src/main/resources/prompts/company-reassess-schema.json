{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oneLineSummary",
    "verdict",
    "positionReview",
    "risks"
  ],
  "properties": {
    "oneLineSummary": {
      "type": "string",
      "description": "80자 이내 한 문장 요약. 매수/매도/보유/추천 같은 투자 판단 단어를 쓰지 않는다."
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stance",
        "headline",
        "reason",
        "basis"
      ],
      "description": "이 사람의 보유 상태를 전제로 한 판정. 종목 자체에 대한 일반 의견이 아니다. 같은 종목이라도 비중과 평단가가 다르면 다른 판정이 나와야 한다.",
      "properties": {
        "stance": {
          "type": "string",
          "enum": [
            "ADD",
            "HOLD",
            "TRIM",
            "EXIT",
            "UNCLEAR"
          ],
          "description": "ADD 더 담아도 되는 상태 / HOLD 그대로 두는 상태 / TRIM 비중을 줄일 상태 / EXIT 정리를 검토할 상태 / UNCLEAR 근거가 모자라 판단을 보류. 근거가 약하면 억지로 고르지 말고 UNCLEAR 를 쓴다."
        },
        "headline": {
          "type": "string",
          "description": "판정을 사람 말로 옮긴 한 줄. 20자 이내. 예: 더 담지 마세요 / 그대로 두세요"
        },
        "reason": {
          "type": "string",
          "description": "왜 그 판정인지 300자 내외. 반드시 이 사람의 비중과 평단가를 근거에 포함한다. 앱이 준 숫자를 다시 계산하지 말고 그대로 인용한다."
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "NEWS",
              "VALUATION",
              "MACRO",
              "INDUSTRY",
              "PRICE",
              "CONCENTRATION"
            ]
          },
          "description": "판정이 무엇에 기댔는지. 화면에 근거 종류로 표시된다."
        }
      }
    },
    "positionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "notApplicableReason",
        "body",
        "bullets"
      ],
      "description": "POSITION_REVIEW 섹션. 지금 가격·보유 상태에서의 위치. 보유하지 않은 종목이면 applicable=false, notApplicableReason \"보유하지 않은 종목\", body 는 빈 문자열.",
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "notApplicableReason": {
          "type": "string",
          "description": "applicable 이면 빈 문자열"
        },
        "body": {
          "type": "string",
          "description": "두괄식. 문단은 빈 줄로 나눈다."
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "고려할 만한 관점 3~6개. 매매 지시가 아니라 관점."
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "이 보유 상태에서 사용자가 실제로 감당하고 있는 리스크 2~5개.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "detail",
          "severity"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "예: 단일 종목 집중"
          },
          "detail": {
            "type": "string",
            "description": "왜 리스크인지 2~4문장. 보유현황 블록의 숫자를 인용한다."
          },
          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      }
    }
  }
}