# HTTPS 는 Caddy 가 Let's Encrypt 로 알아서 받고 갱신한다. DOMAIN 의 DNS 가 이 서버를 가리켜야 한다.
# DOMAIN=localhost 로 두면 Caddy 내부 인증서로 뜬다 (내 PC 에서 리허설할 때).

{$DOMAIN} {
	encode zstd gzip

	# 관리 주소(/actuator)는 앱이 8081 에만 열어서 여기로는 애초에 안 온다. 혹시 몰라 한 번 더 막는다
	respond /actuator* 404

	# X-Forwarded-For·Proto 는 Caddy 가 붙인다. 앱은 이걸로 사용자 IP(호출 한도)와 https 여부(쿠키)를 안다.
	# 바깥에서 보낸 X-Forwarded-For 는 Caddy 가 믿지 않고 덮어쓴다(trusted_proxies 를 안 정했으므로)
	reverse_proxy app:8080 {
		# 요청마다 번호를 붙여 넘긴다. 앱(RequestIdFilter)이 이 번호를 로그와 응답 헤더 X-Request-Id 에 쓴다.
		# 바깥에서 보낸 같은 이름 헤더는 이 값으로 덮어쓴다(아무나 번호를 정하지 못하게)
		header_up X-Request-Id {http.request.uuid}
		# 배포로 앱이 다시 뜨는 20초 남짓 동안 502 를 돌려주지 않고, 그 요청을 잡고 기다렸다 넘긴다.
		# 리허설에서 이걸 넣기 전에는 배포마다 13초쯤 502 가 났다
		lb_try_duration 30s
		lb_try_interval 500ms
		# Caddy → 앱 연결은 다시 쓴다(keep-alive). 놀던 연결은 30초 뒤에 Caddy 가 먼저 닫는다.
		# 앱(Tomcat)의 keep-alive-timeout(60초)보다 짧아야 한다. 반대면 Tomcat 이 막 닫은 연결에
		# Caddy 가 요청을 실어 보내 가끔 502 가 난다(재현이 어려운 간헐 오류)
		transport http {
			keepalive 30s
			keepalive_idle_conns 32
		}
	}

	# HSTS 는 스프링 시큐리티가 https 요청에 붙인다. 여기서 또 붙이면 헤더가 두 번 나간다
	header -Server
}
