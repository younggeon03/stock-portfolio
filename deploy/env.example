# 운영 서버의 deploy/.env 견본. 서버에서만 만들고 저장소에는 절대 올리지 않는다.
#   cp env.example .env && chmod 600 .env && nano .env
# deploy.sh 가 띄우기 전에 ★ 표시 값을 검사하고, 빠졌으면 배포를 멈춘다.

# ── 서버 ──
DOMAIN=stock.example.com                  # ★ DNS A 레코드가 이 서버 IP 를 가리켜야 HTTPS 가 발급된다
APP_BASE_URL=https://stock.example.com    # 피드·사이트맵 주소에 쓰인다
COOKIE_SECURE=true                        # ★ https 에서만 세션 쿠키를 보낸다
SWAGGER_ENABLED=false                     # ★ 주소 목록이 공격 지도가 되지 않게

# ── 로그인 ── 비면 로그인이 꺼진다(개발 모드). 서버에서 비면 내 잔고가 공개된다
OWNER_USERNAME=owner
OWNER_PASSWORD=                           # ★ 긴 무작위 값: openssl rand -base64 24

# ── DB ── 컨테이너 안에서만 쓰인다. 바깥에 포트를 열지 않는다
COMPOSE_DB_PASSWORD=                      # ★ openssl rand -base64 24
COMPOSE_DB_ROOT_PASSWORD=                 # ★ openssl rand -base64 24

# ── 증권사 토큰 암호화 ── 잃어버리면 저장된 토큰을 못 읽는다(다시 받으면 된다). 백업과 따로 보관
TOKEN_ENCRYPTION_KEY=                     # ★ openssl rand -base64 32

# ── 바깥 API 키 ── 내 PC .env 와 같은 값 (설명은 ../.env.example)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
NAMUH_APP_KEY=
NAMUH_APP_SECRET=
NAMUH_ACCOUNT_NO=
ANTHROPIC_API_KEY=
DART_API_KEY=
SEC_USER_AGENT=
OPENFIGI_API_KEY=

# ── 알림(선택) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── 백업(선택) ── rclone 원격 저장소 이름:경로. 비우면 서버 디스크에만 14일
# BACKUP_REMOTE=
