<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mystock</groupId>
    <artifactId>portfolio</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>portfolio</name>
    <description>토스증권 Open API 기반 개인 포트폴리오 분석/리밸런싱 웹앱</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- REST 컨트롤러 + 내장 톰캣 + RestClient(HTTP 클라이언트) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA(Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- @Valid, @NotBlank 등 입력값 검증 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL 드라이버 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            스키마를 SQL 파일(src/main/resources/db/migration)로 관리한다.
            Hibernate 가 테이블을 알아서 고치게(ddl-auto: update) 두면 컬럼 삭제·이름 변경이 반영 안 되고,
            무엇이 언제 바뀌었는지 기록도 없다. 운영 DB 는 사람이 검토한 SQL 로만 바꾼다.
            Flyway 10 부터 MySQL 지원이 별도 모듈이라 flyway-mysql 도 필요하다.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--
            Claude(Anthropic) 공식 자바 SDK.
            기업분석을 클로드에게 맡길 때 쓴다. 웹검색 도구도 이 SDK 를 통해 선언한다.
        -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.62.0</version>
        </dependency>

        <!--
            API 문서 자동 생성 (springdoc-openapi).

            컨트롤러를 읽어 주소·파라미터·응답 형태를 스스로 만들어낸다.
            손으로 쓴 API 문서는 코드를 고칠 때마다 같이 안 고쳐져서 결국 거짓말을 시작한다.
            그래서 목록은 여기에 맡기고, 사람이 쓴 docs/아키텍처.md 7장(API 계약)에는
            코드만 봐서는 알 수 없는 것(비용, 헤더의 의미, 없는 기능)만 남겼다.

            ※ 버전을 올리지 마세요. 2.6.0 이 Spring Boot 3.3 에 맞는 마지막 버전입니다.
              2.7 이상은 Spring Framework 6.2 (Boot 3.4) 의 LiteWebJarsResourceResolver 를 찾기 때문에
              기동 중에 NoClassDefFoundError 로 죽습니다. 실제로 2.8.17 로 올렸다가 겪었습니다.
              올리려면 Spring Boot 부터 올려야 합니다.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!--
            로그인. 공개 기능(기관 포트폴리오 등)은 누구나, 내 잔고와 유료 버튼은 나만.
            서버에 올리면 주소만 알면 누구나 내 계좌를 보고 클로드 비용을 쓰게 할 수 있어서 붙였다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            운영 상태를 바깥에 알리는 주소 (/actuator/health, /actuator/prometheus).
            자동 배포가 "새 버전이 제대로 떴나" 를 판단하는 근거가 health 이고,
            Prometheus 가 호출 수·응답 시간을 긁어가는 곳이 prometheus 다.
            둘 다 관리 포트(8081)에만 열어 바깥에는 안 보이게 한다 (application.yml).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          바깥 API 서킷 브레이커. 호스트 하나가 계속 실패하면 잠시 호출을 멈춰 스레드가 타임아웃을 기다리며 쌓이지 않게 한다.
          스프링 부트 스타터(애노테이션·AOP)는 쓰지 않고 핵심 모듈만 쓴다. RestClient 인터셉터 한 곳에서 모든 호출에 건다
          (HttpClientResilienceConfig). 상태는 micrometer 로 Prometheus 에 나간다
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!--
          바깥 API 의 HTTP 클라이언트(커넥션 풀). 버전은 스프링 부트가 관리한다.
          이걸 넣기 전에는 RestClient 가 Anthropic SDK 를 따라 들어온 OkHttp 를 "아무도 고르지 않은 채" 쓰고 있었다
          (스프링 부트가 HttpComponents → Jetty → OkHttp → JDK 순으로 클래스패스에서 찾는다). 풀 크기·유휴 정리·
          소켓 옵션을 직접 정하고 Micrometer 로 풀 사용량을 보려고 명시한다(HttpClientResilienceConfig)
        -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!--
            서버 로그를 JSON 한 줄씩으로 찍는다(LOG_FORMAT=json 일 때만, logback-spring.xml).
            사람이 읽는 줄글은 grep 으로만 찾을 수 있지만, JSON 은 jq·로그 수집기가 필드(requestId, level)로 거른다.
            스프링 부트 3.4 부터는 내장 기능이 있지만 3.3 에는 없어서 logstash 인코더를 쓴다. 8.x 가 logback 1.5 짝이다
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                테스트 커버리지. `mvnw test` 가 끝나면 target/site/jacoco/ 에 보고서가 생긴다.
                CI 가 이 숫자를 PR 화면에 띄운다. 아직 최소 기준으로 빌드를 막지는 않는다.
                외부 API 를 부르는 클라이언트는 일부러 테스트하지 않아서(키가 필요함) 전체 숫자는 낮게 나온다.
                숫자 자체보다 "계산하는 코드(service, filing, dart, edgar)가 덮여 있나" 를 본다.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <!--
                    커버리지 최소선. CI 가 테스트 뒤에 `mvnw jacoco:check` 로 따로 부른다(빌드 단계에 묶지 않음).
                    내 PC 는 경로의 한글 때문에 JaCoCo 에이전트가 깨져서, 단계에 묶으면 로컬 빌드가 멈춘다.

                    ★ 계산하는 코드에만 건다 (2026-10-07 수치에서 몇 %p 아래로)
                    전체 숫자는 키가 필요한 바깥 API 클라이언트(일부러 테스트 안 함) 때문에 41% 로 낮다. 그걸 올리려고
                    의미 없는 테스트를 쓰게 만들고 싶지 않다. 대신 틀리면 돈·판단이 틀어지는 곳(분석 조립·공시 재무
                    계산·공개 기업분석 문장)은 지금 수준 밑으로 떨어지면 PR 을 막는다. 테스트를 지우거나, 테스트 없이
                    큰 코드를 넣으면 걸린다. 수치가 오르면 이 선도 같이 올린다(내려가는 방향으로는 안 고친다).
                -->
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.38</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>PACKAGE</element>
                            <includes><include>com.mystock.portfolio.external.filing</include></includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>PACKAGE</element>
                            <includes>
                                <include>com.mystock.portfolio.service.analysis</include>
                                <include>com.mystock.portfolio.service.stock</include>
                                <include>com.mystock.portfolio.external.edgar</include>
                            </includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.60</minimum></limit>
                            </limits>
                        </rule>
                        <rule>
                            <element>PACKAGE</element>
                            <includes><include>com.mystock.portfolio.external.dart</include></includes>
                            <limits>
                                <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
