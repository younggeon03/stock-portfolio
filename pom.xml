<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mystock</groupId>
    <artifactId>portfolio</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>portfolio</name>
    <description>토스증권 Open API 기반 개인 포트폴리오 분석/리밸런싱 웹앱</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- REST 컨트롤러 + 내장 톰캣 + RestClient(HTTP 클라이언트) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA(Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- @Valid, @NotBlank 등 입력값 검증 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL 드라이버 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            스키마를 SQL 파일(src/main/resources/db/migration)로 관리한다.
            Hibernate 가 테이블을 알아서 고치게(ddl-auto: update) 두면 컬럼 삭제·이름 변경이 반영 안 되고,
            무엇이 언제 바뀌었는지 기록도 없다. 운영 DB 는 사람이 검토한 SQL 로만 바꾼다.
            Flyway 10 부터 MySQL 지원이 별도 모듈이라 flyway-mysql 도 필요하다.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--
            Claude(Anthropic) 공식 자바 SDK.
            기업분석을 클로드에게 맡길 때 쓴다. 웹검색 도구도 이 SDK 를 통해 선언한다.
        -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.62.0</version>
        </dependency>

        <!--
            API 문서 자동 생성 (springdoc-openapi).

            컨트롤러를 읽어 주소·파라미터·응답 형태를 스스로 만들어낸다.
            손으로 쓴 API 문서는 코드를 고칠 때마다 같이 안 고쳐져서 결국 거짓말을 시작한다.
            그래서 목록은 여기에 맡기고, 사람이 쓴 docs/아키텍처.md 7장(API 계약)에는
            코드만 봐서는 알 수 없는 것(비용, 헤더의 의미, 없는 기능)만 남겼다.

            ※ 버전을 올리지 마세요. 2.6.0 이 Spring Boot 3.3 에 맞는 마지막 버전입니다.
              2.7 이상은 Spring Framework 6.2 (Boot 3.4) 의 LiteWebJarsResourceResolver 를 찾기 때문에
              기동 중에 NoClassDefFoundError 로 죽습니다. 실제로 2.8.17 로 올렸다가 겪었습니다.
              올리려면 Spring Boot 부터 올려야 합니다.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!--
            로그인. 공개 기능(기관 포트폴리오 등)은 누구나, 내 잔고와 유료 버튼은 나만.
            서버에 올리면 주소만 알면 누구나 내 계좌를 보고 클로드 비용을 쓰게 할 수 있어서 붙였다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            운영 상태를 바깥에 알리는 주소 (/actuator/health, /actuator/prometheus).
            자동 배포가 "새 버전이 제대로 떴나" 를 판단하는 근거가 health 이고,
            Prometheus 가 호출 수·응답 시간을 긁어가는 곳이 prometheus 다.
            둘 다 관리 포트(8081)에만 열어 바깥에는 안 보이게 한다 (application.yml).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          바깥 API 서킷 브레이커. 호스트 하나가 계속 실패하면 잠시 호출을 멈춰 스레드가 타임아웃을 기다리며 쌓이지 않게 한다.
          스프링 부트 스타터(애노테이션·AOP)는 쓰지 않고 핵심 모듈만 쓴다. RestClient 인터셉터 한 곳에서 모든 호출에 건다
          (HttpClientResilienceConfig). 상태는 micrometer 로 Prometheus 에 나간다
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>2.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                테스트 커버리지. `mvnw test` 가 끝나면 target/site/jacoco/ 에 보고서가 생긴다.
                CI 가 이 숫자를 PR 화면에 띄운다. 아직 최소 기준으로 빌드를 막지는 않는다.
                외부 API 를 부르는 클라이언트는 일부러 테스트하지 않아서(키가 필요함) 전체 숫자는 낮게 나온다.
                숫자 자체보다 "계산하는 코드(service, filing, dart, edgar)가 덮여 있나" 를 본다.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
