# 이 파일을 복사해서 ".env" 라는 이름으로 저장하고 실제 값을 채워 넣으세요.
# .env 파일 자체는 .gitignore 에 등록되어 있어 git 커밋되지 않습니다.
# client_secret 은 절대 코드나 깃에 넣지 마세요.

# ─────────────────────────────────────────────────────────────
# 1) 토스증권 Open API 인증 정보
#    발급 위치: 토스증권 WTS(웹 트레이딩) > 설정 > Open API
#
#    ※ 같은 화면의 "허용 IP 관리" 에 지금 쓰는 공인 IP 를 등록해야 합니다.
#      등록하지 않으면 토큰 발급이 HTTP 403 으로 막힙니다.
#      내 공인 IP 확인: https://ifconfig.me
# ─────────────────────────────────────────────────────────────
TOSS_CLIENT_ID=여기에_클라이언트_ID
TOSS_CLIENT_SECRET=여기에_클라이언트_시크릿

# 2단계에서 사용할 계좌 식별 키(accountSeq).
# 지금은 비워두세요. 1단계 인증이 끝나면 GET /api/toss/accounts 로 조회해서 채웁니다.
TOSS_ACCOUNT_SEQ=

# ─────────────────────────────────────────────────────────────
# 2) 나무증권(NAMUH PLUG) Open API
#    발급 위치: https://www.nhplug.com  (API 사용신청 필요)
#
#    ※ 나무증권 API 는 두 가지가 있습니다.
#      - 구형 mynamuh.com OpenAPI: 윈도우 DLL 방식이라 이 앱에서 못 씁니다 (2023-05-31 신규 신청 종료)
#      - 신형 NAMUH PLUG: REST 방식. 이걸 발급받으세요.
# ─────────────────────────────────────────────────────────────
NAMUH_APP_KEY=여기에_appkey
NAMUH_APP_SECRET=여기에_appsecretkey

# 주식 잔고 조회가 되는 계좌번호.
# 비워두면 계좌 목록에서 acct_type 이 01 인 계좌를 자동으로 고릅니다.
NAMUH_ACCOUNT_NO=

# ─────────────────────────────────────────────────────────────
# 3) Claude(Anthropic) API  — 기업분석 기능에만 씁니다
#    발급 위치: https://console.anthropic.com
#
#    ※ 토스·나무와 달리 키가 하나뿐입니다. 시크릿이 따로 없습니다.
#    ※ 사용한 만큼 과금됩니다. 콘솔의 Plans & Billing 에서 크레딧을 충전해야 동작합니다.
#      잔액이 없으면 "크레딧이 부족합니다" 안내가 뜹니다.
#    ※ 1종목 분석 1회에 대략 $0.5~2 정도 듭니다. 한 번 분석하면 DB에 저장돼서
#      다시 볼 때는 추가 비용이 들지 않습니다.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-여기에_키

# ─────────────────────────────────────────────────────────────
# 4) DART(금융감독원 전자공시) OpenAPI — 국내 종목 재무에 씁니다
#    발급 위치: https://opendart.fss.or.kr → 인증키 신청/관리
#
#    ※ 무료이고 40자리 키 하나뿐입니다. 하루 2만 건까지 됩니다.
#    ※ 비워두면 재무를 붙이지 않고 클로드가 웹에서 찾습니다 (덜 정확합니다).
# ─────────────────────────────────────────────────────────────
DART_API_KEY=

# ─────────────────────────────────────────────────────────────
# 5) SEC EDGAR — 미국 종목 재무에 씁니다
#    발급할 것이 없습니다. 키가 없고 무료입니다.
#
#    ※ 대신 SEC 가 "누가 부르는지" 를 밝히라고 요구합니다. 형식: 앱이름 연락처이메일
#      이게 없으면 SEC 가 403 으로 막습니다.
#    ※ 비워두면 미국 종목 재무를 붙이지 않고 클로드가 웹에서 찾습니다.
# ─────────────────────────────────────────────────────────────
SEC_USER_AGENT=PortfolioApp 여기에_이메일

# ─────────────────────────────────────────────────────────────
# 6) MySQL 접속 정보
#    로컬에 MySQL 을 띄워두고 portfolio 데이터베이스를 미리 만들어 두세요.
#      CREATE DATABASE portfolio DEFAULT CHARACTER SET utf8mb4;
# ─────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/portfolio?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=여기에_비밀번호

# ─────────────────────────────────────────────────────────────
# 7) 운영 설정 (선택). 내 PC 에서는 비워둬도 됩니다
#    MANAGEMENT_PORT  헬스체크·지표 주소(/actuator/*)를 여는 포트. 기본 8081
#    SWAGGER_ENABLED  서버에서는 false. 주소 목록이 바깥에 보이지 않게 합니다
#    OWNER_USERNAME / OWNER_PASSWORD  내 영역(잔고·유료 버튼) 로그인. 아이디 기본값은 owner
#      비밀번호를 비우면 로그인 없이 전부 열립니다 (내 PC 개발용). 서버에서는 필수. 길고 무작위로
#    COOKIE_SECURE  HTTPS 뒤(서버)에서는 true. 내 PC(http)에서 true 면 로그인이 안 됩니다
#    TOKEN_ENCRYPTION_KEY  증권사 토큰을 DB 에 암호화해서 넣는 키 (base64, 32바이트). 서버에서는 필수
#      만들기:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#           또는 openssl rand -base64 32
#      비우면 평문으로 저장합니다. 키를 잃어버리거나 바꾸면 토큰을 한 번 새로 발급받을 뿐입니다
#    OPENFIGI_API_KEY  기관 13F 의 CUSIP 을 티커로 바꿀 때. 없어도 되지만 느립니다. 무료: https://www.openfigi.com/api
#    APP_BASE_URL  피드·알림 글 속 링크의 주소. 서버면 https://도메인 (기본 http://localhost:8080)
#    TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  새 13F 를 텔레그램 채널로. 만드는 법은 docs/운영.md 5장
#    ※ 쓸 때만 앞의 # 을 지우세요. "MANAGEMENT_PORT=" 처럼 빈 값으로 두면 기본값 대신 빈 값이 들어가 기동이 깨집니다
# ─────────────────────────────────────────────────────────────
# MANAGEMENT_PORT=8081
# SWAGGER_ENABLED=false
# OWNER_USERNAME=owner
# OWNER_PASSWORD=여기에_긴_비밀번호
# COOKIE_SECURE=true
# TOKEN_ENCRYPTION_KEY=여기에_base64_44자
# OPENFIGI_API_KEY=여기에_키
# APP_BASE_URL=https://도메인
# TELEGRAM_BOT_TOKEN=여기에_봇_토큰
# TELEGRAM_CHAT_ID=@채널이름
